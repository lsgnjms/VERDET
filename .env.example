# Copy this file to .env and fill in the values. Never commit .env.

# --- Hedera operator (from portal.hedera.com) -------------------------------
# Testnet only. app/hedera.py refuses to start if this is anything else.
NETWORK=testnet
OPERATOR_ID=0.0.0000000
OPERATOR_KEY=your-operator-private-key
# Key type, parsed explicitly (no auto-detection): ecdsa or ed25519
OPERATOR_KEY_TYPE=ecdsa
# How the key is written: hex (64 hex chars, optional 0x) or der (starts with 30...)
OPERATOR_KEY_FORMAT=hex

# --- App secrets ------------------------------------------------------------
# Signs the login session cookie. Generate with:
#   .venv\Scripts\python.exe -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me
# Encrypts the custodial user keys stored in the database. Generate with:
#   .venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If you lose or change this, stored user keys can no longer be decrypted.
KEY_ENCRYPTION_SECRET=change-me

# --- Database ---------------------------------------------------------------
# SQLite file locally; a Postgres URL (Neon) in production.
DATABASE_URL=sqlite:///./verdet.db

# --- Mirror node ------------------------------------------------------------
MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1

# --- Created by scripts/setup_hedera.py (paste its output here) -------------
VKWH_TOKEN_ID=
REGISTRY_TOPIC_ID=
READINGS_TOPIC_ID=
TRADES_TOPIC_ID=
